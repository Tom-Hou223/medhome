  <view class="menu-section">
    <van-cell-group>
      <van-cell
        wx:for="{{menuList}}"
        wx:key="title"
        title="{{item.title}}"
        icon="{{item.icon}}"
        is-link
        bindtap="onMenuClick"
        data-url="{{item.url}}"
        data-needlogin="{{item.needLogin}}"
        data-title="{{item.title}}"
      />
    </van-cell-group>
  </view>

  <view class="login-logout-section">
    <van-button
      type="primary"
      size="large"
      bind:click="onToggleGuestMode"
      custom-style="background-color: #27ae60; border-color: #27ae60; width: 100%; height: 80rpx; font-size: 32rpx; border-radius: 50rpx;"
    >
      {{isGuestMode ? '登录' : '退出'}}
    </van-button>
  </view>

  <view class="version-info">
    <text class="version-text">medhome v2.0.0</text>
  </view>

  
</view>
