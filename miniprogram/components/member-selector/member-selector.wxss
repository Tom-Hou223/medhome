.member-selector-card {
  background: #ffffff;
  border-radius: 50rpx;
  padding: 14rpx 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.16);
  transition: all 0.3s;
}

.member-selector-card.clickable:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.selector-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333333;
}

.selector-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selector-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.selector-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #27ae60;
}

.selector-popup {
  display: flex;
  flex-direction: column;
  max-height: 70vh;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.popup-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
  border-radius: 50%;
}

.popup-close:active {
  background-color: #f0f0f0;
  transform: scale(0.9);
}

.popup-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 32rpx 80rpx;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-item:active {
  background-color: #f8f9fa;
  margin: 0 -32rpx;
  padding: 32rpx;
}

.member-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-item-name {
  font-size: 30rpx;
}

.member-item.selected .member-item-name {
  color: #27ae60;
  font-weight: bold;
}

.member-item.unselected .member-item-name {
  color: #999999;
  font-weight: normal;
}
